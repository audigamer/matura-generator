@model int?

<div class="card shadow-sm border-0 p-4 mb-4 bg-white rounded-2">
    <h5 class="fw-bold mb-3 text-dark">Пример за генериране</h5>
    <div class="row g-3">
        <div class="col-md-6">
            <div class="p-3 bg-light rounded-2 border">
                <div class="text-muted small fw-semibold mb-1">Дефиниция в шаблон:</div>
                <div class="font-monospace text-dark small mb-2">
                    По-големият корен на уравнението $Ax^2 + Bx + C = 0$ е:
                </div>
                <div class="text-secondary small">
                    Правило: $B^2 - 4AC$ e точен квадрат
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 bg-light rounded-2 border">
                <div class="text-muted small fw-semibold mb-1">Конкретна генерирана задача:</div>
                <div class="text-dark mb-2">
                    По-големият корен на уравнението $x^2 + x − 6 = 0$ е: 
                </div>
                <div class="text-secondary small">
                    Очакван резултат: $x = 2$
                </div>
            </div>
        </div>
    </div>
    @if (Model.HasValue)
    {
        <div class="mt-3 text-end">
            <a asp-controller="Practice" asp-action="Generate" asp-route-id="@Model.Value" class="btn btn-outline-primary btn-sm">
                Тествай решаване с реален шаблон →
            </a>
        </div>
    }
</div>
