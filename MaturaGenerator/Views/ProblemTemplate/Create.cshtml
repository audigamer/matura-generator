@model MaturaGenerator.Models.ViewModels.ProblemTemplateViewModel

@{
    ViewData["Title"] = "Създаване на шаблон";
}

<h2>Създаване на шаблон</h2>
<hr />

<div class="row">
    <div class="col-md-7">
        <form asp-action="Create" method="post" autocomplete="off">
            <partial name="_ProblemTemplateForm" model="Model" />

            <button type="submit" class="btn btn-primary">Запазване</button>
            <a asp-action="Index" class="btn btn-secondary">Към списъка</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/domain-editor.js" asp-append-version="true"></script>
    <script src="~/js/answer-rule-editor.js" asp-append-version="true"></script>
}
