@model List<MaturaGenerator.Models.ViewModels.DomainInputModel>

<div class="mb-4">
    <h5>Constant Domains</h5>
    <div id="domainsContainer" class="border rounded p-3 bg-light">
        <p id="emptyState" class="text-muted m-0" style="@(Model.Count > 0 ? "display:none;" : "")">
            Type constants in the Statement (e.g. <code>@@A</code>, <code>@@B</code>) to configure them here.
        </p>

        @for (int i = 0; i < Model.Count; i++)
        {
            <div class="domain-card bg-white border rounded p-3 mb-2" data-constant="@Model[i].ConstantName">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-primary fs-6 domain-badge">@@@Model[i].ConstantName</span>
                    <input type="hidden" class="domain-name" asp-for="@Model[i].ConstantName" />
                    <select class="form-select form-select-sm w-auto type-select" asp-for="@Model[i].Type">
                        <option value="int">Integer</option>
                        <option value="fraction">Fraction</option>
                    </select>
                </div>
                <div class="int-fields d-flex gap-2 @(Model[i].Type == "fraction" ? "d-none" : "")">
                    <div>
                        <label class="form-label small text-muted mb-0">Min</label>
                        <input type="number" class="form-control form-control-sm min-val" asp-for="@Model[i].MinValue" />
                    </div>
                    <div>
                        <label class="form-label small text-muted mb-0">Max</label>
                        <input type="number" class="form-control form-control-sm max-val" asp-for="@Model[i].MaxValue" />
                    </div>
                </div>
                <div class="fraction-fields row g-2 @(Model[i].Type == "int" ? "d-none" : "")">
                    <div class="col-6">
                        <label class="form-label small text-muted mb-0">Min Numerator</label>
                        <input type="number" class="form-control form-control-sm min-num" asp-for="@Model[i].MinNumerator" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted mb-0">Max Numerator</label>
                        <input type="number" class="form-control form-control-sm max-num" asp-for="@Model[i].MaxNumerator" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted mb-0">Min Denominator</label>
                        <input type="number" class="form-control form-control-sm min-den" asp-for="@Model[i].MinDenominator" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted mb-0">Max Denominator</label>
                        <input type="number" class="form-control form-control-sm max-den" asp-for="@Model[i].MaxDenominator" />
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<template id="domainCardTemplate">
    <div class="domain-card bg-white border rounded p-3 mb-2">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-primary fs-6 domain-badge"></span>
            <input type="hidden" class="domain-name" />
            <select class="form-select form-select-sm w-auto type-select">
                <option value="int">Integer</option>
                <option value="fraction">Fraction</option>
            </select>
        </div>
        <div class="int-fields d-flex gap-2">
            <div>
                <label class="form-label small text-muted mb-0">Min</label>
                <input type="number" class="form-control form-control-sm min-val" value="1" />
            </div>
            <div>
                <label class="form-label small text-muted mb-0">Max</label>
                <input type="number" class="form-control form-control-sm max-val" value="10" />
            </div>
        </div>
        <div class="fraction-fields d-none row g-2">
            <div class="col-6">
                <label class="form-label small text-muted mb-0">Min Numerator</label>
                <input type="number" class="form-control form-control-sm min-num" value="1" />
            </div>
            <div class="col-6">
                <label class="form-label small text-muted mb-0">Max Numerator</label>
                <input type="number" class="form-control form-control-sm max-num" value="10" />
            </div>
            <div class="col-6">
                <label class="form-label small text-muted mb-0">Min Denominator</label>
                <input type="number" class="form-control form-control-sm min-den" value="1" />
            </div>
            <div class="col-6">
                <label class="form-label small text-muted mb-0">Max Denominator</label>
                <input type="number" class="form-control form-control-sm max-den" value="10" />
            </div>
        </div>
    </div>
</template>
