@model IEnumerable<MaturaGenerator.Models.ProblemTemplate>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Всички шаблони за задачи</h2>
    <a asp-action="Create" class="btn btn-primary">
        + Нов шаблон
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th scope="col" class="py-3 ps-4">Заглавие</th>
                <th scope="col" class="py-3">Клас</th>
                <th scope="col" class="py-3">Условие</th>
                <th scope="col" class="py-3">Създаден на</th>
                <th scope="col" class="py-3 pe-4 text-end">Действия</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold ps-4">@item.Title</td>
                    <td>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                            @item.TargetGrade клас
                        </span>
                    </td>
                    <td class="text-secondary" style="max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        @item.Statement
                    </td>
                    <td class="text-muted small">@item.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td class="pe-4 text-end text-nowrap">
                        <a asp-action="Generate" asp-controller="Practice" asp-route-id="@item.Id" class="btn btn-primary btn-sm me-1">Решаване</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm me-1">Редактиране</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;"
                              onsubmit="return confirm('Сигурни ли сте, че искате да изтриете този шаблон?');">
                            <button type="submit" class="btn btn-outline-danger btn-sm">Изтриване</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
