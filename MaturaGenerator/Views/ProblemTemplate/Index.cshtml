@model IEnumerable<MaturaGenerator.Models.ProblemTemplate>

<h2>Всички шаблони за задачи</h2>

<table class="table">
    <thead>
    <tr>
        <th>Заглавие</th>
        <th>Клас</th>
        <th>Условие</th>
        <th>Създаден на</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.TargetGrade</td>
            <td>@item.Statement</td>
            <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
            <td>
                <a asp-action="Generate" asp-controller="Practice" asp-route-id="@item.Id" class="btn btn-primary btn-sm me-1">Решаване</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info btn-sm me-1">Редактиране</a>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;"
                      onsubmit="return confirm('Сигурни ли сте, че искате да изтриете този шаблон?');">
                    <button type="submit" class="btn btn-danger btn-sm">Изтриване</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>