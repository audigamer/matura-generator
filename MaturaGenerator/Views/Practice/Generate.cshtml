@using static MaturaGenerator.Models.ViewModels.PracticeSessionViewModel
@model MaturaGenerator.Models.ViewModels.PracticeSessionViewModel

@{
    ViewData["Title"] = "Practice Problem";
}

<div class="container py-4">
    @switch (Model)
    {
        case Error err:
            <div class="alert alert-warning shadow-sm mb-4">
                <h5 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Генерирането е неуспешно</h5>
                <p class="mb-2">@err.Details.Description</p>
                <hr/>
                <div class="d-flex gap-2">
                    <a asp-action="Generate" asp-route-id="@err.Template.Id" class="btn btn-warning btn-sm">
                        <i class="bi bi-arrow-repeat"></i> Нов опит
                    </a>
                    <a asp-action="Edit" asp-controller="ProblemTemplate" asp-route-id="@err.Template.Id"
                       class="btn btn-outline-secondary btn-sm">
                        Редактиране на шаблона
                    </a>
                    <a asp-action="Index" asp-controller="ProblemTemplate" class="btn btn-outline-secondary btn-sm">Към списъка</a>
                </div>
            </div>
            break;

        case Active active:
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">@active.Problem.Template.Title</h4>
                    <span class="badge bg-light text-primary">@active.Problem.Template.TargetGrade клас</span>
                </div>
                <div class="card-body text-center py-5">
                    <div class="fs-4 my-4 p-4 bg-light rounded border text-start">
                        @active.Problem.RenderedText
                    </div>
                    
                    <partial name="_AnswerInputPartial" model="active"/>
                    
                    <div>
                        <a asp-action="Generate" asp-route-id="@active.Problem.Template.Id"
                           class="btn btn-primary btn-lg me-2">
                            <i class="bi bi-arrow-repeat"></i> Нова задача
                        </a>
                        <a asp-action="Index" asp-controller="ProblemTemplate" class="btn btn-outline-secondary btn-lg">Към списъка</a>
                    </div>
                </div>
            </div>
            break;
    }
</div>

@section Scripts {
    <script src="~/js/practice-answer.js" asp-append-version="true"></script>
}