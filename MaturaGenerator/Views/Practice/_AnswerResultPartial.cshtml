@using static MaturaGenerator.Models.ViewModels.AnswerCheckResult
@model MaturaGenerator.Models.ViewModels.AnswerCheckResult

@{
    string message = Model switch
    {
        Correct c => $"Браво! Завършено след {c.TimeTakenSeconds} секунди.",
        Incorrect inc => $"Грешен отговор. Отговорът беше {inc.CorrectAnswer}.",
        TimeExpired exp => $"Времето изтече! Време: {exp.TimeTakenSeconds} секунди.",
        SessionNotFound => "Сесията не беше намерена или е изтекла.",
        _ => "Възникна неочаквана грешка."
    };
}

<p class="mb-0">@message</p>